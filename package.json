{
  "name": "@frankyyouchill/step-code-acp",
  "version": "0.2.3",
  "description": "Community ACP adapter for the installed Step Code CLI, with a session-scoped T3 orchestration bridge",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "FrankyYouChill",
  "repository": {
    "type": "git",
    "url": "https://github.com/FrankyYouChill/step-code-acp.git"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "scripts": {
    "build": "node prepare-adapter.mjs",
    "setup": "npm run build && node scripts/install.mjs",
    "uninstall": "node scripts/install.mjs --uninstall",
    "test": "node --test test-t3-mcp.mjs test-security.mjs && node smoke-acp.mjs --simulate-failure",
    "smoke": "node smoke-acp.mjs",
    "smoke:mcp": "node smoke-t3-mcp.mjs",
    "package": "node scripts/package-release.mjs",
    "audit:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "pi-acp": "0.0.34"
  },
  "overrides": {
    "@agentclientprotocol/sdk": "0.26.0",
    "zod": "4.6.7"
  }
}
